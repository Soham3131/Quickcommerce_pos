# ==============================================================================
# AVANI GROCERS — VERCEL DEMO MODE CONFIGURATION
# ==============================================================================
# This configuration runs Avani Grocers as a fully interactive demo deployment
# without MongoDB Atlas or external services (Razorpay, Cloudinary, SMTP).
# All modifications persist in the browser's LocalStorage.
#
# Configure these variables in your Vercel Project Settings -> Environment Variables:
# ==============================================================================

# Enable Explicit Database-Free Demo Mode (Required)
APP_DATA_MODE=demo
NEXT_PUBLIC_APP_DATA_MODE=demo

# Authentication & Session Security (Required for JWT signing)
# Generate with: openssl rand -base64 32
AUTH_SECRET=avani_demo_secret_jwt_key_vercel_2026_quickcommerce_pos_demo_32chars

# Session Validity (Optional: default 604800 = 7 days)
SESSION_MAX_AGE_SECONDS=604800

# Canonical Application URL (Optional: replace with your Vercel deployment URL)
NEXTAUTH_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
